<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>SmartClipBoard</string>
	<key>CFBundleDisplayName</key>
	<string>SmartClipBoard</string>
	<key>CFBundleIdentifier</key>
	<string>com.vladimirbelaev.smartclipboard</string>
	<key>CFBundleExecutable</key>
	<string>SmartClipBoard</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- Agent app: no Dock icon, no ⌘Tab entry, no menu bar menus. -->
	<key>LSUIElement</key>
	<true/>
	<!-- Keep the 0.5 s clipboard check punctual; the app does almost no work per tick. -->
	<key>NSAppSleepDisabled</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
